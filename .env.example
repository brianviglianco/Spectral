# Environment Configuration for Spectral
# Copy to .env and customize for your environment

# === GENERAL ===
NODE_ENV=development
LOG_LEVEL=info

# === PATHS (use absolute paths in production) ===
REPORTS_PATH=./reports
SCREENSHOTS_PATH=./screenshots
DATA_PATH=./data

# === REDIS (Queue Management) ===
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
QUEUE_NAME=spectral-jobs
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT_MS=120000

# === DASHBOARD ===
DASHBOARD_PORT=3000
DASHBOARD_HOST=0.0.0.0
NEXT_PUBLIC_API_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000

# === AUTHENTICATION (implement before production!) ===
JWT_SECRET=change-this-secret-in-production
API_KEY=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# === PUPPETEER ===
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
PUPPETEER_HEADLESS=true
PUPPETEER_TIMEOUT=60000
PUPPETEER_SANDBOX=true

# === STORAGE (Phase 2+) ===
STORAGE_PROVIDER=local  # local | s3 | r2
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# === DATABASE (Phase 2+) ===
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# === MONITORING ===
SENTRY_DSN=
DD_API_KEY=
DD_APP_KEY=

# === CLEANUP POLICIES ===
CLEANUP_ENABLED=true
CLEANUP_SCHEDULE="0 2 * * *"  # 2 AM daily
REPORTS_RETENTION_DAYS=30
SCREENSHOTS_RETENTION_DAYS=7
MAX_STORAGE_GB=50

# === FEATURE FLAGS ===
ENABLE_FORENSICS=true
ENABLE_AI_REMEDIATION=false
ENABLE_MULTI_CMP=false
LIMITED_MODE=false