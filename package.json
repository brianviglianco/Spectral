{
  "name": "spectral",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "cycle:de": "npm run cycle -- de",
    "cycle:fr": "npm run cycle -- fr",
    "cycle:it": "npm run cycle -- it",
    "cycle:es": "npm run cycle -- es",
    "cycle:nl": "npm run cycle -- nl",

    "cycle": "bash -c 'region=$1; shift; bash scripts/run-p0-matrix.sh $region config/sites-anchor.json && bash p0-verify.sh && bash scripts/make-forensic-all.sh \"reports/spectral-analysis-*.json\" && node scripts/manifest-tools.js verify reports/forensic && node scripts/manifest-tools.js index reports/forensic' --",

    "verify:p0": "node verifyP0.js",
    "verify:forensic": "node scripts/manifest-tools.js verify reports/forensic",
    "index:forensic": "node scripts/manifest-tools.js index reports/forensic",

    "backup": "node scripts/createBackup.js",
    "audit": "node scripts/auditWorkspace.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.12",
    "archiver": "^6.0.2",
    "puppeteer": "^24.19.0"
  }
}
