  }
  
  if (hasFacebook) {
    output.push('❌ Facebook Pixel - Loading before consent');
    output.push('   Impact: Attribution data incomplete, ROAS inaccurate');
    output.push('   Fix: Block pixel until OneTrust C0004 consent');
  }
  
  if (hasLinkedIn) {
    output.push('❌ LinkedIn Insight Tag - Pre-consent activation');
    output.push('   Impact: B2B conversion tracking unreliable');
    output.push('   Fix: Load conditionally with OneTrust');
  }
  output.push('');

  // Revenue Impact
  output.push('💰 REVENUE IMPACT CALCULATOR');
  output.push(drawBox());
  output.push('Current State (Non-Compliant):');
  output.push(`  • Pre-consent tracking: ${metrics.baseline.hits} hits`);
  output.push('  • Risk: €10M-€90M fines, customer trust loss');
  output.push('  • Brand damage: Negative PR, customer churn');
  output.push('');
  output.push('After Compliance (Recommended):');
  output.push('  • Consent-based tracking: Legal data collection');
  output.push('  • Risk reduction: 90% lower regulatory exposure');
  output.push('  • Trust premium: 15-25% higher customer LTV');
  output.push('  • Competitive advantage: Privacy-first positioning');
  output.push('');

  // Consent Rate Benchmarks
  output.push('📊 CONSENT RATE BENCHMARKS');
  output.push(drawBox());
  output.push('Industry Average Consent Rates:');
  output.push('  • Retail: 45-55% accept all cookies');
  output.push('  • Finance: 35-45% accept all cookies');
  output.push('  • Tech/SaaS: 50-65% accept all cookies');
  output.push('  • Media: 30-40% accept all cookies');
  output.push('');
  output.push('Optimization Strategies:');
  output.push('  1. Clear value exchange messaging');
  output.push('  2. Granular consent categories');
  output.push('  3. Easy consent management UI');
  output.push('  4. Trust signals (certifications, policies)');
  output.push('');

  // Server-Side Tracking
  output.push('🔄 SERVER-SIDE TRACKING ALTERNATIVES');
